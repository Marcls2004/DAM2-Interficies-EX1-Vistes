<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="15" xmlns:fx="http://javafx.com" fx:controller="com.project.ControllerVistaA" prefWidth="400" prefHeight="300">
    <Label text="Formulari d'Alta" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    
    <HBox alignment="CENTER" spacing="10">
        <Label text="Nom:" prefWidth="50"/>
        <TextField fx:id="txtNom" promptText="Introdueix el teu nom"/>
    </HBox>
    
    <HBox alignment="CENTER" spacing="10">
        <Label text="Edat:" prefWidth="50"/>
        <TextField fx:id="txtEdat" promptText="Introdueix la teva edat"/>
    </HBox>
    
    <Button fx:id="btnEnviar" text="Enviar" onAction="#enviarDades"/>
</VBox>
